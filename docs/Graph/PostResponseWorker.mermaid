graph TB
    %% ============================================================
    %% PostResponseMemoryWorker — 回复后异步 invalidation（退休）执行链路
    %% 依据代码：memory2/post_response_worker.py、memory2/memorizer.py
    %%   (supersede_batch:249)、memory2/store.py (mark_superseded_batch:614)、
    %%   memory2/retriever.py (retrieve:83)、core/memory/events.py
    %%   (TurnIngested / MemoryWritten)、plugins/default_memory/engine.py
    %%   (_on_turn_committed:657 / _wire_memory2_events 订阅:652)
    %% 本图 = MemorySystem-Evolution「② 退休」来源3 的完整展开
    %% 对应 T_ENTRY → T_SRC3 → T_I1/T_I2/T_I3 → T_MK3 那一支。
    %% 跨图一致术语：memory_types=["procedure","preference"]、score≥0.82、
    %%   protected_ids、action="supersede"、"superseded_ids"。
    %% ============================================================
    %% ====== 样式 ======
    classDef mem fill:#ffe082,color:#e65100
    classDef step fill:#fff8e1,color:#e65100,stroke:#ffe082,stroke-width:1px
    classDef gate fill:#fff9c4,color:#f57f17,stroke:#ffe082,stroke-width:1px
    classDef file fill:#ffffff,color:#bf360c,stroke:#ffcc80,stroke-width:1px
    classDef event fill:#ce93d8,color:#4a148c,stroke:#ce93d8,stroke-width:1px
    classDef async fill:#e0e0e0,color:#616161,stroke:#bdbdbd,stroke-width:1px,stroke-dasharray:5 3
    classDef final fill:#a5d6a7,color:#1b5e20,stroke:#66bb6a,stroke-width:2px
    classDef db fill:#b3e5fc,color:#01579b,stroke:#4fc3f7,stroke-width:1px
    classDef flow fill:#e0f7fa,color:#006064,stroke:#4dd0e1,stroke-width:1px

    %% ═══════════════ ① 入口：TurnIngested 事件触发 ═══════════════
    P_SRC["触发源: engine._on_turn_committed<br/>回执提交后入队 TurnIngested<br/>(engine.py:657-673)"]
    P_SRC -->|"EventBus 广播"| P_SUB["订阅: on TurnIngested<br/>→ handle 分派<br/>(engine.py:652)"]
    P_SUB -->|"异步后台执行"| P_HANDLE["handle() 解包事件字段<br/>post_response_worker.py:53"]
    P_HANDLE -->|"转发 run"| P_RUN["run() 建立本轮上下文<br/>token_budget = 1000<br/>post_response_worker.py:64"]
    P_RUN -.->|"异常: try/except"| P_EXC["logger.warning<br/>仅日志不阻塞（async）"]

    %% ═══════════════ ② 收集显式 memorize（无 LLM） ═══════════════
    P_RUN --> P_COL["_collect_explicit_memorized(tool_chain)<br/>post_response_worker.py:132<br/>无 LLM 调用"]
    P_COL -->|"读 arguments.summary"| P_SUMM["summaries 排除列表<br/>仅 debug 日志用"]
    P_COL -->|"解析结果文本 id<br/>正则 new/reinforced/merged:id<br/>或 item_id=..."| P_PROT["protected_ids<br/>本轮新写入条目<br/>禁止被 supersede"]
    P_SUMM -.->|"仅日志"| P_LOG["logger 计数"]

    %% ═══════════════ ③ invalidation 主链路 ═══════════════
    P_PROT -->|"传入"| P_INV["_handle_invalidations<br/>post_response_worker.py:174"]
    P_INV --> P_G1{"扣预算 96<br/>_consume_budget<br/>TOKENS_EXTRACT_INVALIDATION<br/>剩余 ≥ 96?"}
    P_G1 -->|"否 → 跳过"| P_SKIP["预算不足<br/>本轮不退休"]
    P_G1 -->|"是 → 扣 96"| P_EXTR["_extract_invalidation_topics<br/>post_response_worker.py:239<br/>light 模型<br/>否定词+agent 行为对象判定<br/>返回主题 JSON 数组"]
    P_EXTR -->|"大多数消息返回 []"| P_TG{"topics 非空?"}
    P_TG -->|"否 → 本轮结束"| P_END["run 完成<br/>不退休"]
    P_TG -->|"是"| P_LOOP{"还有未处理<br/>topic?"}
    P_LOOP -->|"否"| P_END
    P_LOOP -->|"是"| P_RETR["retriever.retrieve(topic)<br/>memory_types=[procedure,preference]<br/>post_response_worker.py:199"]
    P_RETR --> P_HS{"score ≥ 0.82<br/>且 id ∉ protected_ids?"}
    P_HS -->|"否 → 下一 topic"| P_LOOP
    P_HS -->|"是 → 截取 K"| P_K5["取前 K=5<br/>SUPERSEDE_CANDIDATE_K"]
    P_K5 -->|"候选 high_sim"| P_G2{"剩余预算<br/>超过 96?<br/>TOKENS_CHECK_INVALIDATE"}
    P_G2 -->|"否 → 跳过"| P_LOOP
    P_G2 -->|"是 → 扣 96"| P_CHK["_check_invalidate<br/>post_response_worker.py:289<br/>light 模型<br/>从候选内选 id（防幻觉）"]
    P_CHK -->|"返回选中 id"| P_CD{"supersede_ids<br/>非空?"}
    P_CD -->|"否 → 下一 topic"| P_LOOP
    P_CD -->|"是"| P_SUP["supersede_batch<br/>memorizer.py:249<br/>→ mark_superseded_batch"]
    P_SUP -->|"落库软删除"| P_DB["UPDATE memory_items<br/>SET status=superseded<br/>store.py:614"]
    P_SUP -->|"广播事件"| P_FAN["EventBus.fanout<br/>MemoryWritten<br/>action=supersede<br/>superseded_ids=[...]<br/>post_response_worker.py:226-235"]
    P_DB --> P_LOOP
    P_FAN --> P_LOOP
    P_REF["⚓ 读效果: 检索过滤 status=active<br/>superseded 不召回但保留可溯源<br/>同规则见 MemorySystem-Evolution<br/>「② 退休 T_EFFECT」"]

    %% ====== 样式应用 ======
    class P_SRC,P_SUB flow
    class P_HANDLE,P_RUN,P_COL,P_INV,P_EXTR,P_RETR,P_CHK,P_SUP step
    class P_G1,P_TG,P_LOOP,P_HS,P_K5,P_G2,P_CD gate
    class P_SKIP,P_LOG,P_EXC async
    class P_END final
    class P_DB db
    class P_FAN event
    class P_REF mem