flowchart TB
    %% ============================================================
    %% Rachael 引擎（AgenticRAG graph 源）— message-as-truth 图谱记忆
    %% 依据代码：plugins/rachael/engine.py、plugins/rachael/store.py、
    %%          plugins/rachael/config.py
    %% ============================================================
    %% ====== 样式 ======
    classDef mem fill:#ffe082,color:#e65100
    classDef step fill:#fff8e1,color:#e65100,stroke:#ffe082,stroke-width:1px
    classDef gate fill:#fff9c4,color:#f57f17,stroke:#ffe082,stroke-width:1px
    classDef file fill:#ffffff,color:#bf360c,stroke:#ffcc80,stroke-width:1px
    classDef event fill:#ce93d8,color:#4a148c,stroke:#ce93d8,stroke-width:1px
    classDef async fill:#e0e0e0,color:#616161,stroke:#bdbdbd,stroke-width:1px,stroke-dasharray:5 3
    classDef db fill:#b3e5fc,color:#01579b,stroke:#4fc3f7,stroke-width:1px

    LEG_MEM["⚓ 定位：本图展开 AgenticRAG 多引擎检索中的 graph 源（rachael 引擎）内部结构；<br/>与 default_memory（vector 源，见 MemorySystem-MultiLevel）平行，用自有 RachaelStore（sessions.db 图谱）<br/>原则：message-as-truth —— 以原始对话消息为记忆真相，答具体事实用 fetch_messages(source_ref) 取原文"]

    %% ═══════════════════════════════════════════
    %% 写入 — TurnCommitted 事件驱动
    %% ═══════════════════════════════════════════
    subgraph WRITE["写入 — TurnCommitted 事件驱动"]
        direction TB
        W_TURN["TurnCommitted 事件<br/>session_key 非 scheduler 且未 skip_post_memory"]
        W_LOAD["_load_committed_turn_messages<br/>从 sessions.db 取本轮 user/assistant"]
        W_EMB["Embedder.embed_batch<br/>embed 消息内容（model=text-embedding-v3）"]
        W_TURN --> W_LOAD
        W_LOAD --> W_EMB
        W_EMB --> W_NODE["upsert_message_node<br/>每条消息 → 节点（含 embedding）<br/>初始化 salience / strength / resource"]
        W_EMB --> W_CACHE["upsert_cached_embedding<br/>→ embedding 缓存"]
        W_NODE --> W_EDGE["upsert_edges<br/>与上一轮建共现边 + 权重<br/>+ 激活事件"]
        W_REINF["reinforce_memory 工具<br/>用户纠正/强调时加强本轮<br/>boost 节点强度"]
    end

    %% ═══════════════════════════════════════════
    %% 读出 — dense 精确 + ripple 联想
    %% ═══════════════════════════════════════════
    subgraph READ["读出 — dense 精确命中 + ripple 联想命中"]
        direction TB
        R_Q["query（recall_memory 工具 /<br/>AgenticRAG graph lane）"]
        R_EMB["embed query_vec"]
        R_Q --> R_EMB
        R_EMB --> R_DENSE["dense 语义检索<br/>_dense_message_candidates<br/>按 embedding 相似度 KNN<br/>dense_top_k=10"]
        R_DENSE --> R_SEED["graph seed keys<br/>_graph_seed_keys_from_snapshot<br/>阈值 dense_seed_threshold=0.675"]
        R_SEED --> R_RIP["ripple 图谱扩散<br/>_compute_candidates_from_snapshot<br/>从 seed 沿 akasha_edges 扩散<br/>激活阈值 0.22 · soft_recall 0.165"]
        R_RIP --> R_CARD["卡片组装<br/>dense_cards + ripple_cards<br/>→ context block / recall 结果"]
        R_RIP --> R_STATE["激活状态更新<br/>update_activation_batch<br/>→ 更新节点 salience/strength/resource"]
    end

    %% ═══════════════════════════════════════════
    %% 存储 — RachaelStore 图谱
    %% ═══════════════════════════════════════════
    subgraph STORE["RachaelStore — sessions.db 图谱"]
        direction TB
        S_NODE["akasha_nodes（节点表）<br/>key PK · anchor_id · turn_seq<br/>embedding · salience · strength · resource<br/>recall_count · last_activated_ts"]
        S_EDGE["akasha_edges（边表）<br/>src_key · dst_key · weight · co_count<br/>last_used_ts"]
        S_ACT["akasha_activation_events（激活表）<br/>query_id → 激活节点<br/>分数分解：direct/state/edge/long/resource"]
        S_QLOG["akasha_query_log（检索日志）<br/>query_id · dense/ripple 计数<br/>激活统计 · 注入字符数"]
        S_EMB["akasha_embedding_cache（缓存表）<br/>message_id → embedding · dim"]
    end

    %% ═══════════════════════════════════════════
    %% 读写 × 存储连线
    %% ═══════════════════════════════════════════
    W_NODE --> S_NODE
    W_EDGE --> S_EDGE
    W_CACHE --> S_EMB
    W_REINF --> S_NODE
    R_DENSE -.->|"读: 节点 embedding"| S_NODE
    R_RIP -.->|"读: 沿边扩散"| S_EDGE
    R_RIP -.->|"写: 激活事件"| S_ACT
    R_RIP -.->|"写: 检索日志"| S_QLOG
    R_STATE -.->|"写: 更新节点"| S_NODE

    %% ====== 样式应用 ======
    class LEG_MEM async
    class W_TURN,W_LOAD,W_EMB,W_NODE,W_EDGE,W_CACHE,W_REINF step
    class R_Q,R_EMB,R_DENSE,R_SEED,R_RIP,R_CARD,R_STATE step
    class S_NODE,S_EDGE,S_ACT,S_QLOG,S_EMB db
