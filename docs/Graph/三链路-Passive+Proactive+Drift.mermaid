graph TB
    %% ====== 样式 ======
    classDef passPhase fill:#90caf9,color:#0d47a1
    classDef proPhase fill:#f8bbd0,color:#880e4f
    classDef driftPhase fill:#a5d6a7,color:#1b5e20
    classDef shared fill:#ce93d8,color:#4a148c
    classDef mem fill:#ffe082,color:#e65100
    classDef exitSkip fill:#e0e0e0,color:#616161,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray:5 3

    %% ====== 消息来源 ======
    CH[Channel层<br/>Telegram / QQ / CLI] -->|InboundMessage| MBI
    PL[ProactiveLoop<br/>定时器] -->|TickEvent| MBI
    SC[SpawnCompletion<br/>子 Agent 返回] -->|SpawnCompletionItem| MBI

    MBI[MessageBus<br/>asyncio.Queue] -->|consume_inbound| DISPATCH{AgentLoop.run<br/>消息类型判断}

    %% ====== 分发分支 ======
    DISPATCH -->|InboundMessage| CREATE[create_task 异步处理]
    DISPATCH -->|TickEvent| KERNEL[ProactiveKernel.run_tick<br/>直接调用]
    DISPATCH -->|SpawnCompletionItem| SPAWN[合并到当前 Session 历史]

    %% ──── PassiveTurn ────
    CREATE --> CR[CoreRunner.process]
    CR --> PT_PIPELINE

    subgraph PT_PIPELINE[PassiveTurnPipeline — 6 Phase]
        direction TB
        PT_BT[① BeforeTurn<br/>Session 获取<br/>ContextStore.prepare<br/>记忆检索<br/>事件: TurnStarted] --> PT_BR

        PT_BR[② BeforeReasoning<br/>工具上下文同步<br/>技能 @mention 检测<br/>Prompt warmup<br/>事件: BeforeReasoning] --> PT_PR

        PT_PR[③ PromptRender<br/>组装 system 身份+规则<br/>组装 context frame<br/>拼接 history 消息] --> PT_RR

        subgraph PT_RR[④ Reasoner.run_turn — Think-Act-Observe 循环]
            direction TB
            RR_BS[BeforeStep<br/>token 估算<br/>early_stop 检查] --> RR_LLM[LLM.chat<br/>带上工具 schemas<br/>流式 → Channel]
            RR_LLM --> RR_TC{有 tool_calls?}
            RR_TC -->|No| RR_DONE[返回 ReasonerResult]
            RR_TC -->|Yes| RR_VIS{工具已解锁?}
            RR_VIS -->|No| RR_SEARCH[tool_search<br/>申请解锁]
            RR_SEARCH --> RR_LLM
            RR_VIS -->|Yes| RR_EXEC[逐个执行工具]
            RR_EXEC --> RR_HOOK[ToolHook before 链<br/>鉴权 / 限流]
            RR_HOOK --> RR_RUN[ToolExecutor.run<br/>实际调用]
            RR_RUN --> RR_HOOK2[ToolHook after 链<br/>审计 / 日志]
            RR_HOOK2 --> RR_APP[append_tool_result<br/>注入消息历史]
            RR_APP --> RR_AS[AfterStep<br/>事件: ToolCallCompleted]
            RR_AS -->|iteration < max| RR_BS
            RR_AS -->|iteration = max| RR_SUM[生成阶段性摘要]
            RR_SUM --> RR_DONE
        end

        PT_RR --> PT_AR

        PT_AR[⑤ AfterReasoning<br/>解析推理结果<br/>持久化到 Session<br/>构建 OutboundMessage<br/>事件: AfterReasoning] --> PT_AT

        PT_AT[⑥ AfterTurn<br/>写入 PENDING.md<br/>追加 HISTORY.md<br/>追加 journal/<br/>dispatch 出站消息]
    end

    PT_AT -->|OutboundMessage| MBO

    %% ──── ProactiveTurn ────
    KERNEL --> PT_JUDGE{有可推送内容?}
    PT_JUDGE -->|Yes| PRO_PIPELINE

    subgraph PRO_PIPELINE[ProactiveTurnPipeline — 7 阶段决策链路]
        direction TB
        PRO_G[① Gate 准入检查]
        PRO_G --> PRO_G_D{通过?}
        PRO_G_D -->|busy / cooldown<br/>energy 不足| PRO_G_SKIP[跳过本次]
        PRO_G_D -->|通过| PRO_F

        PRO_F[② Fetch 拉取数据<br/>MCP Server 源<br/>Alerts / 提醒<br/>近期上下文摘要] --> PRO_P

        PRO_P[③ Prepare 构建 messages<br/>PromptBuilder 组装<br/>system + context frame<br/>+ kickoff 消息] --> PRO_J

        PRO_J[④ Judge LLM 评估<br/>分类: 是否值得推送?<br/>草稿生成<br/>多轮工具调用<br/>收尾] --> PRO_R

        PRO_R[⑤ Resolve 决策去重<br/>skip / reply 判定<br/>delivery_dedupe<br/>message_dedupe] --> PRO_R_D{决策?}
        PRO_R_D -->|skip| PRO_PERSIST
        PRO_R_D -->|reply| PRO_D

        PRO_D[⑥ Send 执行发送<br/>dispatch → Channel] --> PRO_PERSIST

        PRO_PERSIST[⑦ Persist 持久化 + 日志<br/>record_tick_log_finish<br/>EventBus ProactiveFinished]

        PRO_G_SKIP --> PRO_END
        PRO_END[等待下一 Tick]
    end

    PRO_D -->|推送消息| MBO
    PRO_END -.->|跳过| PL

    PT_JUDGE -->|No| DRIFT_PIPELINE

    subgraph DRIFT_PIPELINE[DriftTurnPipeline — 5 阶段空闲探索<br/>详见 DriftTurnPipeline.mermaid]
        direction TB
        DR_S[① Scan 扫描可用 Skills<br/>store.scan_skills<br/>MCP 源过滤<br/>空则 skip] --> DR_P

        DR_P[② Prepare<br/>设置 drift flags<br/>build_drift_tool_registry<br/>构建 system + context frame<br/>含 self_state / memory / briefing<br/>skill continuum / recent runs] --> DR_E

        subgraph DR_E[③ Execute LLM 工具循环<br/>constrained schema 三阶段]
            direction TB
            DR_SEL["阶段 A: 选择<br/>仅 select_skill / idle_drift<br/>tool_choice = required"] --> DR_ACT["阶段 B: 动作<br/>完整工具集<br/>max 1 message_push"]
            DR_ACT --> DR_FIN_CON["阶段 C: 收尾<br/>push 后仅 finish_drift<br/>steps ≥ max → wrap_up 强制收尾"]
        end

        DR_E --> DR_C

        DR_C[④ Commit 消息提交<br/>Proactive Resolve + Deliver<br/>record_commit_result<br/>→ enqueue DriftFinished]
        DR_C --> DR_F

        DR_F[⑤ Finish 持久化<br/>tick_log + EventBus ProactiveFinished]
    end

    DR_F -->|仅记录, 无用户可见输出| NOP((Drift 结束))

    %% ====== 出站 ======
    MBO[MessageBus<br/>outbound queue] -->|dispatch| CHO[Channel 层<br/>发送给用户]

    %% ====== 记忆检索 — 引擎加载 + AgenticRAG 路由 ======
    subgraph MEM[记忆检索 — 引擎加载 + AgenticRAG 路由]
        direction TB
        ENG_NAMES["config.memory.engine_names<br/>逗号分隔，空 = [default]<br/>例: default,rachael"]
        ENG_LOAD["bootstrap/memory.py 加载<br/>engines: dict[str, MemoryEngine]<br/>default → vector 引擎（memory2）<br/>rachael → graph 引擎（sessions.db）"]
        ENG_NAMES --> ENG_LOAD
        ENG_LOAD --> ROUTER
        ROUTER{"len(engines)?"}
        ROUTER -->|"= 1 单引擎"| MEM_SINGLE["engine.query 直接检索<br/>跳过 Agentic RAG（旧行为）"]
        ROUTER -->|"> 1 多引擎"| MEM_RET["MemoryRetrievalPipeline<br/>AgenticRAGPipeline<br/>Router → Sandbox → Evaluator"]
        MEM_RET --> PLANNER["QueryPlanner 路由<br/>graph / vector / web<br/>规则打分 + LLM 兜底"]
        PLANNER --> SANDBOX["RetrievalSandbox<br/>graph→rachael<br/>vector→default<br/>web→Exa 搜索<br/>并行 + RRF 融合"]
        SANDBOX --> EVAL["Evaluator<br/>LLM 评分 relevance / completeness<br/>query 重写 ≤ 3 次"]
        EVAL --> MEM_RESULT["MemoryBlock<br/>检索结果注入"]
        MEM_SINGLE --> MEM_RESULT

        MEM_FILES["记忆文件系统（物理存储层 · 各引擎共用 markdown 层）<br/>MEMORY.md / SELF.md<br/>PENDING.md / HISTORY.md<br/>RECENT_CONTEXT.md<br/>journal/YYYY-MM-DD.md"]
        MEM_OPT(["MemoryOptimizer<br/>后台定时任务<br/>PENDING → MEMORY.md<br/>config.memory_optimizer_interval_seconds"])

        MEM_NOTE["引擎内部：default/vector 详见<br/>MemorySystem-MultiLevel + Evolution<br/>rachael/graph 待补"]
    end

    %% ====== 记忆连线 ======
    MEM_RET -.->|BeforeTurn: 检索| PT_BT
    PT_AT -->|AfterTurn: 写入<br/>PENDING + HISTORY + journal| MEM_FILES
    MEM_FILES -.->|Fetch: 读取<br/>近期上下文摘要| PRO_F
    MEM_OPT -->|PENDING → MEMORY 合并| MEM_FILES
    MEM_FILES -.->|MemoryOptimizer<br/>定速读取| MEM_OPT

    %% ====== 样式 ======
    class PT_BT,PT_BR,PT_PR,PT_RR,PT_AR,PT_AT passPhase
    class PRO_G,PRO_F,PRO_P,PRO_J,PRO_R,PRO_D,PRO_PERSIST proPhase
    class PRO_END exitSkip
    class DR_S,DR_P,DR_E,DR_F driftPhase
    class CH,PL,SC,MBI,MBO shared
    class MEM_RET,MEM_SINGLE,PLANNER,SANDBOX,EVAL,MEM_RESULT,MEM_FILES,MEM_OPT,ENG_NAMES,ENG_LOAD,ROUTER mem
    class MEM_NOTE exitSkip

    %% ====== 出站线染色 ======
    linkStyle 29 stroke:#66bb6a,stroke-width:2px
    linkStyle 42 stroke:#66bb6a,stroke-width:2px
    linkStyle 43 stroke:#757575,stroke-width:2px,stroke-dasharray:5 3
    linkStyle 52 stroke:#66bb6a,stroke-width:2px

    %% ====== 记忆连线染色 ======
    linkStyle 64,66 stroke:#ffb300,stroke-width:2px
    linkStyle 63,65,67 stroke:#ffb300,stroke-width:2px,stroke-dasharray:5 3
