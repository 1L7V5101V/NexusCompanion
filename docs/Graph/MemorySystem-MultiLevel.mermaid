flowchart TB
    %% ============================================================
    %% 多级结构化记忆系统 — 三级结构 + 数据流
    %% 依据代码：memory2/store.py、memory2/models.py、memory2/memorizer.py、
    %%          memory2/retriever.py、memory2/post_response_worker.py、
    %%          plugins/default_memory/engine.py、_handbook/memory-markdown.md
    %% ============================================================
    %% ====== 样式 ======
    classDef mem fill:#ffe082,color:#e65100
    classDef step fill:#fff8e1,color:#e65100,stroke:#ffe082,stroke-width:1px
    classDef gate fill:#fff9c4,color:#f57f17,stroke:#ffe082,stroke-width:1px
    classDef file fill:#ffffff,color:#bf360c,stroke:#ffcc80,stroke-width:1px
    classDef event fill:#ce93d8,color:#4a148c,stroke:#ce93d8,stroke-width:1px
    classDef async fill:#e0e0e0,color:#616161,stroke:#bdbdbd,stroke-width:1px,stroke-dasharray:5 3
    classDef final fill:#a5d6a7,color:#1b5e20,stroke:#66bb6a,stroke-width:2px
    classDef db fill:#b3e5fc,color:#01579b,stroke:#4fc3f7,stroke-width:1px
    classDef vtable fill:#b2dfdb,color:#00695c,stroke:#80cbc4,stroke-width:1px
    classDef idx fill:#eeeeee,color:#616161,stroke:#bdbdbd,stroke-width:1px
    classDef type fill:#ffffff,color:#8d6e63,stroke:#ffcc80,stroke-width:1px,stroke-dasharray:5 3
    classDef flow fill:#e0f7fa,color:#006064,stroke:#4dd0e1,stroke-width:1px
    %% 主链路配色（与 三链路-Passive+Proactive+Drift.mermaid 一致）
    classDef passPhase fill:#90caf9,color:#0d47a1
    classDef proPhase fill:#f8bbd0,color:#880e4f
    classDef driftPhase fill:#a5d6a7,color:#1b5e20

    %% ═══════════════════════════════════════════
    %% L0 会话工作记忆（短时）
    %% ═══════════════════════════════════════════
    subgraph L0["L0 — 会话工作记忆（原始对话，短时）"]
        direction TB
        L0_MSG["session.messages<br/>当前 session 全部对话历史<br/>每条: role(user/assistant) + content + timestamp"]
        L0_RECENT["Recent Turns 滑动窗口<br/>session 尾部最近 K 条消息<br/>user 全文 + assistant 60 字预览<br/>纯格式化，无 LLM 调用"]
        L0_MSG --> L0_RECENT
    end

    L0_MSG -->|"写: 每轮回复提交 → TurnCommitted 事件<br/>触发 consolidation 写文件（skip_post_memory 可跳过）"| L1_CONS
    L0_MSG -->|"读: 语义查询 → 触发向量+关键词检索"| RETR

    %% ═══════════════════════════════════════════
    %% L1 Markdown 文件层（人类可读全景）
    %% ═══════════════════════════════════════════
    subgraph L1["L1 — Markdown 文件层（人类可读全景 · 记忆文件系统 · workspace/memory/）"]
        direction TB
        L1_CONS["MarkdownMemoryMaintenance<br/>consolidation + 异步文件写入<br/>→ 详见 PassiveTurnPipeline-MemoryConsolidation.mermaid"]
        L1_OPT["MemoryOptimizer 后台定时任务<br/>默认 64800s = 18h 一次<br/>读 PENDING + MEMORY + SELF<br/>LLM 归档决策 → 覆写 MEMORY/SELF"]
        L1_CONS -->|"写: 追加事件日志"| F_HISTORY
        L1_CONS -->|"写: 追加待归档事实"| F_PENDING
        L1_CONS -->|"写: Compression 覆写<br/>+ Recent Turns 刷新"| F_RECENT
        L1_CONS -->|"写: 追加每日时间线"| F_JOURNAL
        L1_OPT -->|"写: LLM 归档覆写"| F_MEM
        L1_OPT -->|"写: 调整自我认知覆写"| F_SELF
        F_PENDING -->|"读 + 消费后清空"| L1_OPT
        F_MEM -->|"读: 作归档上下文"| L1_OPT
        F_SELF -->|"读: 作归档上下文"| L1_OPT

        F_MEM["MEMORY.md 长期用户档案<br/>写者: Optimizer（覆写）<br/>system prompt 全量注入<br/>priority 35"]
        F_SELF["SELF.md Nexus 自我认知<br/>写者: Optimizer<br/>全量注入<br/>priority 30"]
        F_PENDING["PENDING.md 待归档缓冲<br/>写者: Consolidation（追加）<br/>snapshot 两阶段提交防丢<br/>不注入 prompt（保 prompt cache）"]
        F_HISTORY["HISTORY.md 事件日志<br/>写者: Consolidation<br/>只追加不修改<br/>grep 检索 + consolidation 上下文"]
        F_RECENT["RECENT_CONTEXT.md 近期上下文<br/>写者: Consolidation<br/>Compression + Ongoing Threads 注入<br/>priority 45"]
        F_JOURNAL["journal/YYYY-MM-DD.md<br/>每日时间线，追加"]
    end

    L1_CONS -->|"写文件完成 → 发出 ConsolidationCommitted"| CONSOLIDATION["MemoryConsolidator — 记忆整合流程<br/>trigger_memory_consolidation → MarkdownMemoryMaintenance.consolidate<br/>对应子图: PassiveTurnPipeline-MemoryConsolidation"]
    CONSOLIDATION -->|"写: ConsolidationCommitted 事件<br/>history_entry → 向量层 event 条目"| L2_WRITE

    %% ═══════════════════════════════════════════
    %% L2 SQLite v2 向量结构化层
    %% ═══════════════════════════════════════════
    subgraph L2["L2 — SQLite v2 向量结构化层（memory2.db，机器可搜细节）"]
        direction TB
        L2_WRITE["DefaultMemoryEngine._on_consolidation_committed<br/>plugins/default_memory/engine.py 装配<br/>Memorizer + Retriever + PostResponseMemoryWorker"]
        L2_WRITE --> L2_EVT
        L2_WRITE --> L2_LT
        L2_EVT["save_from_consolidation<br/>history_entry → event 条目<br/>upsert_consolidation_event<br/>source_ref 幂等 + 向量语义去重 0.92"]
        L2_LT["_extract_implicit_long_term<br/>LLM 长时提取（一次调用）<br/>profile / preference / procedure<br/>→ save_item_with_supersede 写入"]
        L2_EVT --> T_META
        L2_LT --> T_META

        T_META["memory_items（核心表）— 每条记忆一行<br/>① 识别: id 主键 · memory_type 记忆类型(procedure/preference/event/profile) · content_hash 内容指纹=sha256(摘要+类型)[:16]，同内容判重<br/>② 内容: summary 一句话摘要 · embedding 1024维向量(语义检索用) · extra_json 类型专用字段(每类型不同的细节)<br/>③ 状态: status active可用/superseded被替代 · reinforcement 强化次数(重复出现+1) · emotional_weight 情感权重0-10<br/>④ 溯源: source_ref 来源引用(来自哪条消息/事件) · happened_at 发生时间 · created_at·updated_at 创建/更新时间"]
        T_META -->|"memory_type 四种取值<br/>（存于 extra_json）"| T_TYPES
        subgraph T_TYPES_GRP["类型定义（非表）— memory_type 四种取值<br/>专用字段存于 memory_items.extra_json"]
            direction LR
            T_TYPES["各类型的专用字段"] --> T_PROC["procedure<br/>tool_requirement / steps[]<br/>rule_schema{required/forbidden/mentioned}<br/>trigger_tags 关键词触发"]
            T_TYPES --> T_PREF["preference<br/>行为偏好（无专用字段）"]
            T_TYPES --> T_EVENT["event<br/>scope_channel / scope_chat_id<br/>happened_at 时间戳"]
            T_TYPES --> T_PROF["profile<br/>category: personal_fact<br/>purchase / decision / status"]
        end

        T_IDX["ux_items_hash（唯一索引/约束）<br/>索引列: content_hash(内容指纹) + memory_type(记忆类型)<br/>同一内容再写入会被拦截 →<br/>判定为'强化'而非新增"]
        T_META -->|"建在 memory_items 上"| T_IDX

        T_META -.->|"embedding 同步（rowid 关联）"| T_VEC["vec_items（虚拟表 · vec0）<br/>每条记忆的 embedding(1024维向量) 存这里<br/>检索时按向量距离找'语义相近'的记忆"]
        T_META -.->|"summary 同步（rowid 关联）"| T_FTS["memory_items_fts（虚拟表 · FTS5）<br/>把 summary 建成关键词倒排索引<br/>按关键词搜记忆（如搜'python'）"]
        T_META -.->|"item_id 关联"| T_CONS["consolidation_events（溯源表）<br/>source_ref(来源) → item_id(条目) 映射<br/>保证同一来源只写一次（幂等）"]
        T_META -.->|"old/new item 关联"| T_REPL["memory_replacements（替换谱系表）<br/>old_item(被替换的旧条目) → new_item(新条目)<br/>可追查一条记忆被谁更新过"]
        T_META -.->|"检索快照记录（无外键）"| T_QLOG["memory_query_log（检索日志表）<br/>query(查询内容) / intent(检索意图) / hit_count(命中数) / items_json(返回条目)<br/>记录每次检索，可分析记忆使用情况"]
        LEG_DB["图例：蓝=真表 · 青=虚拟表 · 灰=索引/约束 · 白虚线=类型定义（非表）"]
    end

    %% ═══════════════════════════════════════════
    %% 写入入口（consolidation 之外）
    %% ═══════════════════════════════════════════
    subgraph WRITE["写入入口（除 consolidation 外）"]
        direction TB
        W_MEM["memorize 工具<br/>_remember → save_item_with_supersede<br/>写入门内先做相似 supersede"]
        W_FORGET["forget_memory 工具<br/>_forget → 按 id mark_superseded<br/>软删除"]
        W_POST["PostResponseMemoryWorker<br/>TurnIngested 事件 → 用户否定检测<br/>→ invalidation supersede"]
        W_MEM -->|"写: memorize 工具 → memory_items 条目"| T_META
        W_FORGET -->|"写: forget 工具 → 标 superseded"| T_META
        W_POST -->|"写: 用户否定检测 → supersede 旧条目"| T_META
    end

    %% ═══════════════════════════════════════════
    %% 检索注入（读出路径）
    %% ═══════════════════════════════════════════
    subgraph READ["检索注入 — 读出路径（每轮回复前）"]
        direction TB
        RETR["Retriever.retrieve<br/>memory2/retriever.py<br/>向量 lane（多 query 并嵌）<br/>+ 关键词 lane（FTS5 BM25 / OR-LIKE）<br/>→ RRF 融合 top-k"]
        RETR -.->|"读: 向量 lane → memory_items 语义检索"| T_META
        RETR -.->|"读: 关键词 lane → memory_items_fts 全文检索"| T_FTS
        RETR --> INJ["build_injection_block<br/>强制约束 / 流程规范 / 相关历史<br/>字符预算 1200 + 置信度标注"]
        INJ --> INJECT["system prompt 组装（按 priority）<br/>SELF(30) → MEMORY(35)<br/>→ RECENT_CONTEXT(45) → MemoryBlock(55)"]
        F_MEM -->|"读: MEMORY.md 全量注入 prompt"| INJECT
        F_SELF -->|"读: SELF.md 全量注入 prompt"| INJECT
        F_RECENT -->|"读: RECENT_CONTEXT.md Compression +<br/>Ongoing Threads 注入"| INJECT
    end

    %% ═══════════════════════════════════════════
    %% 定位标注 + 记忆 ↔ 主链路读写触点
    %% ═══════════════════════════════════════════
    LEG_MEM["⚓ 定位：本图是 AgenticRAG 多引擎检索中的 vector 源（default_memory 引擎）内部结构；<br/>graph 源（rachael）与 web 源不在本图范围"]

    PT_BEFORE["被动 BeforeTurn<br/>PassiveTurnPipeline ①"]
    PT_AFTER["被动 AfterTurn<br/>PassiveTurnPipeline ⑥"]
    PRO_FETCH["主动 Fetch<br/>ProactiveTurnPipeline ②"]
    DR_PREP["Drift Prepare<br/>DriftTurnPipeline ②"]

    RETR -.->|"读: MemoryBlock 检索块 → 注入 BeforeTurn prompt"| PT_BEFORE
    PT_AFTER -->|"写: TurnCommitted → 触发 consolidation<br/>追加 HISTORY.md / PENDING.md / journal"| L1_CONS
    F_RECENT -.->|"读: RECENT_CONTEXT.md 近期上下文摘要"| PRO_FETCH
    RETR -.->|"读: MemoryBlock（memory/briefing）→ 注入 Drift Prepare"| DR_PREP

    %% ====== 样式应用 ======
    class LEG_MEM async
    class PT_BEFORE passPhase
    class PT_AFTER passPhase
    class PRO_FETCH proPhase
    class DR_PREP driftPhase
    class L0_MSG,L0_RECENT step
    class L1_CONS,L1_OPT,CONSOLIDATION flow
    class F_MEM,F_SELF,F_PENDING,F_HISTORY,F_RECENT,F_JOURNAL mem
    class L2_WRITE,L2_EVT,L2_LT step
    class T_META,T_CONS,T_REPL,T_QLOG db
    class T_VEC,T_FTS vtable
    class T_IDX idx
    class T_TYPES,T_PROC,T_PREF,T_EVENT,T_PROF type
    class LEG_DB async
    class W_MEM,W_FORGET,W_POST step
    class RETR,INJ,INJECT step

    %% ====== 子图背景（L0-L2 分层记忆系统 / WRITE 写入入口 / READ 读库路径） ======
    style L0 fill:#fff7e6,stroke:#ffb74d
    style L1 fill:#fff7e6,stroke:#ffb74d
    style L2 fill:#fff7e6,stroke:#ffb74d
    style WRITE fill:#f0f9f2,stroke:#a5d6a7
    style READ fill:#eef7fd,stroke:#90caf9
    style T_TYPES_GRP fill:#fff8f0,stroke:#ffcc80,stroke-dasharray:5 3
