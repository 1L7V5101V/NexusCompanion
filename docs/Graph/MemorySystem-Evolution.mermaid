graph LR
    %% ============================================================
    %% 多级结构化记忆系统 — 强化/退休/合并/溯源 四类演化机制
    %% 依据代码：memory2/store.py、memory2/memorizer.py、
    %%          memory2/post_response_worker.py、memory2/retriever.py、
    %%          plugins/default_memory/engine.py
    %% ============================================================
    %% ====== 样式 ======
    classDef mem fill:#ffe082,color:#e65100
    classDef step fill:#fff8e1,color:#e65100,stroke:#ffe082,stroke-width:1px
    classDef gate fill:#fff9c4,color:#f57f17,stroke:#ffe082,stroke-width:1px
    classDef file fill:#ffffff,color:#bf360c,stroke:#ffcc80,stroke-width:1px
    classDef event fill:#ce93d8,color:#4a148c,stroke:#ce93d8,stroke-width:1px
    classDef async fill:#e0e0e0,color:#616161,stroke:#bdbdbd,stroke-width:1px,stroke-dasharray:5 3
    classDef final fill:#a5d6a7,color:#1b5e20,stroke:#66bb6a,stroke-width:2px
    classDef db fill:#b3e5fc,color:#01579b,stroke:#4fc3f7,stroke-width:1px
    classDef cons fill:#e8f5e9,color:#1b5e20,stroke:#a5d6a7,stroke-width:1px
    classDef passPhase fill:#90caf9,color:#0d47a1,stroke:#64b5f6,stroke-width:1px
    classDef flow fill:#e0f7fa,color:#006064,stroke:#4dd0e1,stroke-width:1px

    %% ═══════════════ ① 强化 ═══════════════
    %% 依据代码：memory2/store.py（_content_hash:131, upsert_item:455, upsert_consolidation_event:506,
    %%   reinforce_items_batch:739, find_similar_recent_events:1652, _hotness_score:190, 融合:1378）、
    %%   memory2/memorizer.py（save_from_consolidation:181, _should_semantic_dedup_event:224）、
    %%   memory2/retriever.py（hotness_alpha:55）
    subgraph R["① 强化 — reinforcement 计数器 + 热度融合"]
        direction TB

        %% ── 触发源: ConsolidationCommitted 事件（引擎分派）──
        R_TRIG["触发源: _on_consolidation_committed<br/>订阅 ConsolidationCommitted 事件<br/>engine.py:675 分派两条写入链"]
        R_TRIG -->|"写: history_entry 逐条<br/>→ _save_from_consolidation<br/>→ memorizer.save_from_consolidation"| R_SRC2
        R_TRIG -->|"写: conversation 整段<br/>→ _extract_implicit_long_term<br/>→ _save_implicit_long_term"| R_SRC1

        %% ── 分支 A：event 语义去重 → 抑制写入 ──
        R_SRC2["事件预筛 _should_semantic_dedup_event<br/>save_from_consolidation 落库前调用<br/>（预筛函数，非写入口）"]
        R_SRC2 -->|"读 find_similar_recent_events<br/>event+active+created_at≥7天前 top_k=3<br/>cosine 阈值 0.92"| R_D3{"有相似旧事件<br/>（向量余弦相似度≥0.92?）"}
        R_D3 -->|"是 → 丢弃新事件 + 强化最近似 1 条"| R_FORCE["reinforce_items_batch(similar_ids[:1])<br/>reinforcement+1、emotional_weight 取 MAX<br/>新事件 text 清空不落库"]
        R_D3 -->|"否 → 不丢，走正常写入"| R_SRC1E

        %% ── 分支 B：事件幂等闸门（仅事件路径）──
        R_SRC1E["事件写入入口 upsert_consolidation_event<br/>（仅 memory_type=event<br/>consolidation 产出）"]
        R_SRC1E -->|"读: 查 consolidation_events 登记表（见④）"| R_DID{"source_ref 已登记?"}
        R_DID -->|"已登记 → 同一来源只写一次"| R_SKIP["skipped: 不写入不强化"]
        R_DID -->|"未登记 → 进入 content_hash 链路"| R_HASH

        %% ── 分支 C：content_hash 精确命中 ──
        R_SRC1["通用写入入口 upsert_item<br/>（procedure / preference / profile）<br/>上游: 隐式长期记忆 / memorize 工具"]
        R_SRC1 -->|"算 content_hash → 查库"| R_HASH["_content_hash 计算<br/>SHA256(小写摘要+memory_type)[:16]"]
        R_HASH -->|"读: SELECT id, status<br/>WHERE content_hash=? AND memory_type=?<br/>存在 → 走强化，无 → 新插入"| R_D1{"content_hash 已命中?"}
        R_D1 -->|"否"| R_NEW["INSERT 新条目<br/>id=md5(hash+ts)[:12] reinforcement=1<br/>若带 embedding 同步写 vec_items<br/>返回 new:id"]
        R_D1 -->|"是 → 重复写入变强化"| R_D2{"命中条目 status=superseded?"}
        R_D2 -->|"是 → 复活（重返 active）"| R_REV["复活: 同 content_hash 重写时唤醒旧条目<br/>UPDATE status='superseded'→'active'<br/>+ reinforcement+1, updated_at=now<br/>emotional_weight 取 MAX<br/>event 另用新 happened_at 覆盖空值"]
        R_D2 -->|"否 → 普通+1"| R_ADD["reinforcement+1, updated_at=now<br/>emotional_weight 取 MAX"]

        %% ── 汇入强化计数 ──
        R_NEW -->|"新条目 reinforcement=1（初始）"| R_COUNT
        R_REV -->|"计数+1（复活）"| R_COUNT
        R_ADD -->|"计数+1"| R_COUNT
        R_FORCE -->|"计数+1"| R_COUNT
        R_SRC3["merge_item_raw ③ 合并落库<br/>UPDATE 目标条目 summary/content_hash/embedding<br/>+ extra_json(_merge_note)、reinforcement+1<br/>同步 vec_items（content_hash 冲突→降级 upsert）<br/>store.py:1521"]
        R_SRC3 -->|"merge 目标条目<br/>reinforcement+1（原子 UPDATE）"| R_COUNT

        %% ── 强化终点 ──
        R_COUNT["reinforcement 计数<br/>取值: 整数 ≥1（初始1，每强化+1）<br/>emotional_weight 各分支取 MAX（0-10）<br/>← 演化落库项"]
        R_COUNT -->|"→ 检索时计算热度分"| R_HOT["热度分 _hotness_score<br/>freq = sigmoid(log1p(reinforcement))<br/>recency = 指数衰减 2^(−age / 半衰期)<br/>半衰期 = 14天 × (1+0.5×情感/10)，下限 0.1"]
        R_HOT -->|"→ Retriever 检索分数融合（Agentic RAG中的向量路）"| R_FUSE["检索融合 final<br/>final = (1−α)×语义分 + α×热度分<br/>（Retriever hotness_alpha 默认 α = 0.20）<br/>低于 score_threshold 过滤，按 final 排序<br/>详见 MemorySystem-RetrievalHeat（独立图）<br/>强化产物 reinforcement / emotional_weight<br/>→ 检索热度融合（α=0.20）<br/><br/>适用链路：passive 主链路预检索 +<br/>recall_memory 工具（passive / proactive 通用）<br/>proactive_flow / wake_proactive 的 memory.query<br/>drift 链路不调用记忆检索"]

    end

%% 跨机制关联：强化产物 → 检索读路径（另一机制图）
    %% READ_P["⚓ 检索读路径（热度分 + 融合 + 注入）<br/>详见 MemorySystem-RetrievalHeat（独立图）<br/>强化产物 reinforcement / emotional_weight<br/>→ 检索热度融合（α=0.20）<br/><br/>适用链路：passive 主链路预检索 +<br/>recall_memory 工具（passive / proactive 通用）<br/>proactive_flow / wake_proactive 的 memory.query<br/>drift 链路不调用记忆检索"]

%% ═══════════════ ② 退休 ═══════════════
    subgraph T["② 退休 — supersede 软删除"]
        direction TB

%% ── 触发入口：4 类来源统一接入，全部落在同一层级 ──
        %% 第 5 类「消息删除 undo」目前是未被接入的 API 钩子，见下方注释块，入口线也注释掉。
        T_ENTRY["退休触发入口<br/>supersede 软删除<br/>4 类来源"]
        T_ENTRY -->|"① 写前相似退休"| T_SRC1
        T_ENTRY -->|"② profile 避免堆积"| T_SRC2
        T_ENTRY -->|"③ 用户否定旧行为"| T_SRC3
        T_ENTRY -->|"④ forget_memory 工具"| T_SRC4
        %% T_ENTRY -->|"⑤ 消息删除 undo"| T_SRC5

        %% ── 来源1: procedure / preference 写前相似退休（memory2/memorizer.py save_item_with_supersede）──
        T_SRC1["写入口 save_item_with_supersede<br/>memory_type = procedure / preference 共用<br/>各类型按自身条件触发退休"]
        T_SRC1 -->|"procedure"| T_M1
        T_SRC1 -->|"preference"| T_M2

        T_M1{"候选里是否存在<br/>tool_requirement 相同<br/>且向量余弦相似度 score ≥ 0.70 的合并目标?"}
        T_M1 -->|"是 → 合并,不退休"| T_MGO["合并判定命中：不退休<br/>合并细节见 ③ 合并子图"]
        T_M1 -->|"否 → 进入阈值筛选"| T_M2

        T_M2{"候选向量余弦相似度<br/>score ≥ 0.90?<br/>（supersede_threshold）"}
        T_M2 -->|"是 → 批量退休"| T_MAIN
        T_MAIN["状态机三态归并<br/>mark_superseded_batch<br/>UPDATE status=superseded<br/>（软删除，不物理删）"]
        T_M2 -->|"否"| T_UP1{"新条目 content_hash<br/>已命中既有记忆?"}
        T_UP1 -->|"是 → 命中既有条目"| T_REINF["不新写，转 ① 强化<br/>reinforcement+1 / 复活<br/>（见 R 子图）"]
        T_UP1 -->|"否 → 写新条目"| T_UP2
        T_REINF -.->|"跨子图跳转：走 ① 强化链<br/>upsert_item 写入口<br/>→ content_hash 计算与命中判定"| R_SRC1

        %% ── 来源2: profile 同类避免堆积（memory2/memorizer.py profile 分支）──
        T_SRC2["写入口 save_item_with_supersede<br/>memory_type = profile 分支<br/>(memorizer.py:127)"]
        T_SRC2 --> T_P1
        T_P1{"当前新条目的 extra_json.category<br/>∈ {status, purchase} ?"}
        T_P1 -->|"否 extra_json.category<br/>∈ {personal_fact/decision}<br/>→ 不退休直接写"| T_UP2["upsert 写新条目"]
        T_P1 -->|"是 → 只查同类候选<br/>vector_search memory_types=['profile']"| T_P2{"候选 extra_json.category<br/>与本条相同且<br/>向量余弦相似度 score ≥ 0.90?<br/>（本条 _emotional_weight ≥ 7 时<br/>阈值提到 0.92）"}
        %% 先 vector_search(memory_types=["profile"]) 取 top_k=5，再里层过滤 extra_json.get("category") == category。
        %% 为什么提阈值：情感强烈的记忆更"珍贵"，退休判定收得更严，只有相似度足够高（0.92）才敢软删除——防止因为一次新的同类写入就误删掉高价值的旧偏好。
        T_P2 -->|"是 → 强制避免堆积"| T_MAIN
        T_P2 -->|"否"| T_UP2

        %% ── 来源3：用户否定旧行为（memory2/post_response_worker.py invalidation）──
        T_SRC3["PostResponseMemoryWorker<br/>用户明确否定旧行为<br/>(post_response_worker.py:174)"]
        T_SRC3 --> T_I1
        T_I1{"LLM 提取到<br/>被否定行为主题 topics?"}
        T_I1 -->|"否 → 跳过"| T_SKIP["不触发退休"]
        T_I1 -->|"是 → 每主题检索<br/>procedure/preference 候选"| T_I2{"候选 score ≥ 0.82<br/>且不在本轮<br/>protected_ids 内?"}
        T_I2 -->|"否 → 跳过"| T_SKIP
        T_I2 -->|"是 → LLM 筛选"| T_I3{"LLM _check_invalidate<br/>确认可退休 ids 非空?"}
        T_I3 -->|"否 → 跳过"| T_SKIP
        T_I3 -->|"是 → 批量标记"| T_MK3["supersede_batch 执行退休<br/>＋ fanout MemoryWritten<br/>action=supersede 广播退休事件"]

        %% ── 来源4: forget_memory 工具（plugins/default_memory/engine.py _forget）──
        T_SRC4["forget_memory 工具<br/>仅 Passive 链路可调用<br/>(engine.py:911  _forget)"]
        T_SRC4 --> T_F1
        T_F1{"id 去重后<br/>条目真实存在?"}
        T_F1 -->|"是 → 批量退休标记<br/>mark_superseded_batch"| T_MAIN
        T_F1 -->|"否 → missing_ids 返回"| T_FMISS["missing_ids 返回 tool result"]

        %% ── 来源5（已注释）：消息删除 undo（plugins/default_memory/engine.py _undo_store_by_message_sources）──
        %% ⚠️ 未接入：undo_by_message_sources（engine.py:1028 → _undo_store_by_message_sources engine.py:89）
        %%   目前是未被调用的 API 钩子 —— 全仓库无生产调用方，仅 tests/ 直接调用。
        %%   设计语义：输入被删除消息 id，扫描 source_ref 命中条目改为 superseded，
        %%   且曾作为 new_item 被替换的条目尝试恢复旧条目 active（restore_replacements_for_undo）。
        %%   因无触发方，路径不参与本图执行流，节点与连线全部注释掉。
        %% T_SRC5["undo_by_message_sources<br/>(engine.py:89)"]
        %% T_SRC5 --> T_U1
        %% T_U1{"source_ref 命中<br/>被删除消息 ids?"}
        %% T_U1 -->|"否 → 不受影响"| T_SKIP
        %% T_U1 -->|"是 → 受影响条目"| T_UM["受影响条目<br/>改为 superseded"]
        %% T_UM --> T_U2{"这些条目曾作为<br/>new_item 被替换（记忆来源<br/>memory_replacements 谱系）?"}
        %% T_U2 -->|"是 → 尝试恢复旧条目"| T_UR["旧条目无存活替换<br/>才恢复 active<br/>(restore_replacements_for_undo)"]
        %% T_U2 -->|"否"| T_MAIN
        %% T_UR --> T_DONE["恢复完成"]

        %% ── 收敛：中央状态机 + 读效果 ──
        T_MK3 --> T_MAIN
        %% T_UM --> T_MAIN（来源5 已注释，undo 路径不参与执行流）
        
        T_MAIN -->|"读: 检索过滤 status='active'"| T_EFFECT["检索只召回 active<br/>superseded 不召回但保留可溯源<br/>同 content_hash 重写 → 复活为 active"]
    end

    %% ═══════════════ ③ 合并 ═══════════════
    subgraph M["③ 合并 — merge（仅 memory_type='procedure'）"]
        direction TB
        M_ENTRY["写入入口<br/>procedure 合并链起点<br/>embed 新 summary"]
        M_ENTRY -->|"写: vector_search 同类型候选<br/>memory_type='procedure' top_k=5<br/>score = 候选与新摘要的向量余弦相似度<br/>score_threshold=0.70"| M_D1{"新条目有 tool_requirement?"}
        M_D1 -->|"否"| M_NO["不 merge → 作普通写入处理，进入② 退休判定"]
        M_D1 -->|"是"| M_D2{"候选中有与新摘要向量余弦相似度<br/>score≥0.70 且 tool_requirement 相同?"}
        M_D2 -->|"无"| M_NO
        M_D2 -->|"有 → 命中 merge_target"| M_SUM["_merge_summary_text<br/>新摘要⊆旧 → 用旧摘要<br/>旧摘要⊆新 → 用新摘要<br/>否则 旧摘要；新摘要"]
        %% 核心是字符串子串去重：谁包含谁就用谁，互不包含才拼。图里 新摘要⊆旧 / 旧摘要⊆新 / 否则 旧摘要；新摘要
        M_SUM -->|"→ merge_item"| M_ITEM["merge_item<br/>重 embed 合并后摘要<br/>重算 content_hash<br/>以 old_extra 组装 new_extra"]
        M_ITEM -->|"写: 摘要快照"| M_NOTE["_merge_note = 合并后摘要<br/>存于 memory_items.extra_json"]
        M_ITEM -->|"写: 重建 rule_schema"| M_SCHEMA["build_procedure_rule_schema<br/>required/forbidden/mentioned 重推"]
        M_ITEM -->|"写: steps 去重合并"| M_STEPS["steps 新旧合并去重保序"]
        M_ITEM -->|"写: 清除 trigger_tags"| M_TAGS["清除旧 trigger_tags<br/>防错误关键词触发"]
        M_SCHEMA --> M_RAW
        M_STEPS --> M_RAW
        M_TAGS --> M_RAW
        M_NOTE --> M_RAW
        M_ITEM -->|"→ merge_item_raw 原子落库"| M_RAW["merge_item_raw<br/>UPDATE summary/content_hash/embedding<br/>+ extra_json + reinforcement+1<br/>同步 vec_items（rowid 关联）"]
        M_RAW -->|"返回 merged:目标id"| M_RET["调用方识别 merged 状态<br/>post_response_worker 前缀解析"]
        M_RAW -.->|"异常: content_hash 冲突（极低概率）"| M_FALL["降级: ROLLBACK<br/>supersede 旧条目<br/>upsert_item 写新摘要（变强化）"]
        M_NO -.->|"继续: 落入 ② 退休判定"| T_M2
    end

%% ═══════════════ ④ 溯源 ═══════════════
    subgraph P["④ 溯源 — source_ref 记录来源 / 证据回溯"]
        direction TB

        %% ── 写侧：三类来源 → source_ref 生成 → 落库 ──
        P_S1["来源①：consolidation 事件<br/>history_entry 逐条<br/>引擎分派（engine.py:675）"]
        P_S2["来源②：隐式长期记忆<br/>conversation 整段<br/>（engine.py:1123/1152）"]
        P_S3["来源③：memorize 工具<br/>（engine.py:900 memorize_tool）"]
        P_S1 --> P_GEN
        P_S2 --> P_GEN
        P_S3 --> P_GEN
        P_GEN["source_ref 生成<br/>_build_entry_source_ref<br/>#h:sha1前12位 / #profile / #implicit<br/>memorize 工具无上游"]
        P_GEN -->|"写: memory_items.source_ref 列<br/>同写摘要/哈希 落库"| P_MI["memory_items 主表<br/>每行带来源列 source_ref<br/>（还有 content_hash/status 等）"]
        P_GEN -->|"写: 事件通道登记<br/>upsert_consolidation_event<br/>（store.py:581 登记 / 506 入口）"| P_EVT["consolidation_events 表<br/>source_ref → item_id<br/>同一来源只记一条（幂等）<br/>被 ① 幂等闸门读<br/>（has_consolidation_source_ref）"]

        %% ── 合并快照：写于 ③，此处仅为溯源展示 ──
        P_MI -.->|"读: extra_json._merge_note<br/>溯源展示字段"| P_NOTE["_merge_note 合并快照字段<br/>存于 memory_items.extra_json<br/>写入方见 ③ 合并<br/>（memorizer.py:326）"]

        %% ── 读侧：检索时附加溯源元数据 / 写审计日志 ──
        P_MI -->|"读: 检索召回条目<br/>（source_ref / happened_at）"| P_RET["检索侧 memory.query<br/>default_memory 引擎<br/>召回后附加溯源元数据"]
        P_RET -->|"读: _format_memory_meta<br/>source_ref → src 标记<br/>证据：可回源原文 src:id<br/>或 证据：记忆摘要"| P_EVID["溯源元数据（逐条附加）<br/>发生于/相对时间<br/>置信标签（低分时）<br/>可回源原文 或 记忆摘要"]
        P_EVID -->|"拼进 text_block 的<br/>【相关历史/流程规范】段<br/>→ retrieved_memory_block"| P_INJ["MemoryBlockPromptBlock<br/>priority 55<br/>渲染进 system prompt<br/>（agent/core/prompt_block.py:214）"]
        P_RET -->|"写: insert_query_log<br/>query_text/intent/命中/预览<br/>只写不读（审计）"| P_QLS["memory_query_log 表<br/>检索审计日志"]

        %% 未接线（生产无调用方，仅测试）：
        %% 谱系表 memory_replacements（建表 store.py:91，record_replacements:661）
        %% 结构：old_item_id → new_item_id、relation_type、old/new_source_ref、
        %% created_at。生产链路未调用，仅 tests/test_mid_modules.py、
        %% tests/test_memory_undo.py 直接调用；故不作为节点呈现。
    end


    %% ═══════════════ 悬空子图：落库函数的上游主链路来源 ═══════════════
    %% 说明：本图 R_SRC1（upsert_item）与 R_SRC1E（upsert_consolidation_event）两个落库函数
    %%   是图内的"写终点"，但它们由主链路（三链路-Passive+Proactive+Drift 图）的哪些阶段喂入，
    %%   属于执行流外部说明 —— 悬空放置，不参与本图任何执行流，仅作溯源对照。
    subgraph W["⚓ 悬空：upsert_item / upsert_consolidation_event 来自主链路哪里"]
        direction TB

        %% ── 上游①：Passive 主链路 AfterTurn → 维护后台 → ConsolidationCommitted ──
        W_AT["⑥ AfterTurn（Passive 主链路）<br/>会话落定后提交<br/>TurnCommitted fanout"]
        W_AT --> W_MNT["维护后台<br/>MarkdownMemoryMaintenance<br/>on_turn_committed 入队<br/>（core/memory/markdown.py:1038）<br/>无 LLM 调用"]
        W_MNT --> W_CONS["consolidation 窗口达成<br/>_commit_markdown_draft<br/>→ EventBus emit ConsolidationCommitted<br/>（markdown.py:1200）"]
        W_CONS --> W_DSP["引擎分派<br/>_on_consolidation_committed<br/>（engine.py:675）<br/>并行两条写入链"]

        %% ── 隐式长期记忆链（LLM 提炼）→ upsert_item ──
        W_DSP --> W_IMPL["_extract_implicit_long_term<br/>conversation 整段 LLM 提炼<br/>（engine.py:704）"]
        W_IMPL --> W_SIT["_save_implicit_long_term<br/>（engine.py:1097）<br/>逐条按类型写"]
        W_SIT --> W_SWS["save_item_with_supersede<br/>（memorizer.py:68）<br/>相似退休预检后落库"]
        W_SWS --> W_UPT["★ upsert_item 落库<br/>store.py:445<br/>procedure / preference / profile<br/>即本图「通用写入入口」"]
        %% 落库后即进入本图 ① 强化 R_SRC1 → content_hash 命中判定。

        %% ── 显式 memorize 工具链 → upsert_item ──
        W_REA["④ Reasoner 工具循环<br/>LLM 显式调用 memorize 工具<br/>（Passive 主链路 / 任一路可调）"]
        W_REA --> W_RMEM["_remember<br/>（engine.py:867）<br/>procedure 降级 preference"]
        W_RMEM --> W_SWS

        %% ── 事件历史链（无 LLM）→ upsert_consolidation_event ──
        W_DSP --> W_SFC["_save_from_consolidation<br/>history_entry 逐条<br/>（engine.py:1057）"]
        W_SFC --> W_SFC2["save_from_consolidation<br/>（memorizer.py:168）<br/>embed + event 语义去重预筛<br/>无 LLM 调用"]
        W_SFC2 --> W_UPCE["★ upsert_consolidation_event 落库<br/>store.py:506<br/>memory_type=event<br/>即本图「事件写入入口」"]
        %% 落库后即进入本图 ① 强化 R_SRC1E → source_ref 幂等闸门。
    end

    %% ═══════════════ 跨机制联动 ═══════════════
    T_MGO -.->|"跨子图：合并判定命中 → ③ 合并子图<br/>memory_type='procedure'，存在 tool_requirement 相同<br/>且向量余弦相似度 score ≥ 0.70 的合并目标<br/>从 ③ 写入口 M_ENTRY 起展开合并链"| M_ENTRY
    T_EFFECT -.->|"superseded 条目被同 content_hash 重写复活时，强化计数 +1"| R_COUNT
    M_RAW -.->|"merge_item_raw 更新目标条目时 reinforcement=reinforcement+1<br/>→ 并入 ① 强化计数（强化子图合并落库分支）"| R_SRC3
    M_NOTE -.->|"merge_item 写入的 _merge_note 即④溯源展示的同一 extra_json 字段"| P_NOTE
    T_MAIN -.->|"supersede 软删除后条目仍保留 source_ref<br/>供④溯源记录与证据回溯"| P_GEN
    %% R_COUNT -.->|"只读: 检索热度分输入<br/>reinforcement / emotional_weight"| READ_P

    %% ═══════════════ 定位标注 ═══════════════
    LEG_MEM["⚓ 定位：本图描述 AgenticRAG 多引擎检索中 vector 源（default_memory 引擎）的条目演化机制；<br/>graph 源（rachael）引擎另有实现"]

    %% ====== 样式应用 ======
    %% ── 异步 / 锚点 ──
    class LEG_MEM,T_SKIP,M_FALL,R_SKIP async
    %% ── ① 强化 ──
    class R_TRIG cons
    class R_SRC1,R_SRC1E,R_SRC2,R_SRC3,R_HASH,R_COUNT step
    class R_NEW,R_REV,R_ADD,R_FORCE db
    class R_D1,R_D2,R_D3,R_DID gate
    class R_HOT,R_FUSE passPhase
    %% ── ② 退休 ──
    class T_SRC1,T_SRC2,T_SRC3,T_ENTRY,T_MGO,T_REINF,T_EFFECT step
    class T_SRC4 passPhase
    class T_M1,T_M2,T_P1,T_P2,T_I1,T_I2,T_I3,T_F1,T_UP1 gate
    class T_UP2,T_MAIN db
    class T_MK3 event
    class T_FMISS final
    %% ── ③ 合并 ──
    class M_ENTRY,M_NO,M_SUM,M_ITEM,M_NOTE,M_SCHEMA,M_STEPS,M_TAGS step
    class M_D1,M_D2 gate
    class M_RAW db
    class M_RET final
    class M_FALL async
%% ── ④ 溯源 ──
    class P_S2,P_S3,P_GEN,P_EVID step
    class P_INJ final
    class P_S1 flow
    class P_RET passPhase
    class P_MI,P_EVT,P_NOTE,P_QLS db
    %% ── 悬空子图：落库函数上游来源 ──
    class W_AT,W_REA passPhase
    class W_MNT,W_CONS,W_DSP flow
    class W_IMPL,W_SIT,W_SWS,W_SFC,W_SFC2,W_RMEM step
    class W_UPT,W_UPCE db
