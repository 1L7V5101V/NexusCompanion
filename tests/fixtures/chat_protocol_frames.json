{
  "protocol_version": 0,
  "note": "WebChat dev v0 shared contract fixture (roadmap 5.9.4). Backend tests and the frontend protocol.ts must both conform to these shapes. seq is stamped by the server at send time; null here means the server assigns it. hello 的 account_id/tenant_id/conversation_id 由服务端派生，客户端字段不参与授权。",
  "server_to_client": {
    "hello": {
      "type": "hello",
      "seq": null,
      "connection_id": "0f8b7a1c2d3e4f5a6b7c8d9e0f1a2b3c",
      "protocol_version": 0,
      "account_id": "dev:local",
      "tenant_id": "default",
      "conversation_id": "chat:local",
      "session_key": "chat:local",
      "latest_seq": 42
    },
    "message.accepted": {
      "type": "message.accepted",
      "seq": null,
      "client_message_id": "3f2a9c1e-8b4d-4c3a-9e2f-1a2b3c4d5e6f",
      "session_key": "chat:local"
    },
    "message.delta": {
      "type": "message.delta",
      "seq": null,
      "turn_id": "turn-0f8b",
      "content_delta": "你好",
      "thinking_delta": ""
    },
    "tool.started": {
      "type": "tool.started",
      "seq": null,
      "turn_id": "turn-0f8b",
      "call_id": "call_01",
      "tool_name": "search_messages"
    },
    "tool.completed": {
      "type": "tool.completed",
      "seq": null,
      "turn_id": "turn-0f8b",
      "call_id": "call_01",
      "tool_name": "search_messages",
      "status": "done",
      "result_preview": "共 3 条结果"
    },
    "turn.completed": {
      "type": "turn.completed",
      "seq": null,
      "turn_id": "turn-0f8b",
      "content": "完整回复正文",
      "thinking": null,
      "media": []
    },
    "turn.failed": {
      "type": "turn.failed",
      "seq": null,
      "turn_id": "turn-0f8b",
      "error": "处理消息时出错，请稍后再试。"
    },
    "replay_required": {
      "type": "replay_required",
      "seq": null,
      "after_seq": 12
    },
    "error": {
      "type": "error",
      "seq": null,
      "code": "bad_frame",
      "message": "无法解析的帧"
    },
    "pong": {
      "type": "pong",
      "seq": null
    }
  },
  "client_to_server": {
    "send": {
      "type": "send",
      "client_message_id": "3f2a9c1e-8b4d-4c3a-9e2f-1a2b3c4d5e6f",
      "content": "用户输入",
      "media": []
    },
    "replay": {
      "type": "replay",
      "after_seq": 40
    },
    "ping": {
      "type": "ping"
    }
  },
  "error_cases": {
    "send_missing_client_message_id": {
      "frame": {
        "type": "send",
        "content": "用户输入"
      },
      "expect": {
        "type": "error",
        "code": "bad_client_message_id"
      }
    },
    "send_bad_client_message_id": {
      "frame": {
        "type": "send",
        "client_message_id": "not-a-uuid",
        "content": "用户输入"
      },
      "expect": {
        "type": "error",
        "code": "bad_client_message_id"
      }
    },
    "send_empty_content": {
      "frame": {
        "type": "send",
        "client_message_id": "3f2a9c1e-8b4d-4c3a-9e2f-1a2b3c4d5e6f",
        "content": ""
      },
      "expect": {
        "type": "error",
        "code": "bad_request"
      }
    },
    "unknown_type": {
      "frame": {
        "type": "mystery"
      },
      "expect": {
        "type": "error",
        "code": "unknown_type"
      }
    },
    "bad_replay_cursor": {
      "frame": {
        "type": "replay",
        "after_seq": -1
      },
      "expect": {
        "type": "error",
        "code": "bad_replay"
      }
    }
  },
  "identity": {
    "dev_account_id": "dev:local",
    "dev_tenant_id": "default",
    "dev_conversation_id": "chat:local",
    "session_key": "chat:local"
  },
  "replay_semantics": {
    "replayable_types": ["message.accepted", "turn.completed", "turn.failed"],
    "droppable_types": ["message.delta", "tool.started", "tool.completed"],
    "never_replayed_types": ["hello", "message.delta", "tool.started", "tool.completed", "error", "pong", "replay_required"],
    "soft_limit": 192,
    "hard_limit": 256,
    "max_payload_bytes": 1048576,
    "overload_close_code": 1013,
    "idle_close_code": 1001,
    "dev_only_close_code": 1008
  },
  "error_codes": [
    "bad_frame",
    "unknown_type",
    "bad_client_message_id",
    "bad_request",
    "bad_replay",
    "overload",
    "dev_only"
  ]
}
